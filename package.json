{
  "name": "social-warm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && npm run clean && vite build && vite build -c vite.content.config.ts",
    "icons": "node scripts/icons.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "screenshots": "node scripts/screenshots.mjs",
    "probe": "node scripts/probe.mjs",
    "auth": "node scripts/auth.mjs"
  },
  "dependencies": {
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-openai": "^1.0.0",
    "@tanstack/ai-openrouter": "^1.0.0",
    "@tanstack/highlight": "^1.2.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/redact": "^0.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bestzip": "^4.0.3",
    "playwright": "^1.64.1",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "version": "1.0.0",
  "description": "Warm up your X account: gather targets, apply an AI-reviewed plan.",
