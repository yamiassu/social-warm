{
  "manifest_version": 3,
  "name": "Social Warm-Up",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Warm up X, Reddit, LinkedIn, Instagram and YouTube: gather what to like, comment and follow, then apply it with human-like pacing.",
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://pbs.twimg.com/*", "https://www.reddit.com/*", "https://www.linkedin.com/*", "https://www.instagram.com/*", "https://www.youtube.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Social Warm-Up",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.reddit.com/*", "https://www.linkedin.com/*", "https://www.instagram.com/*", "https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
